{
  "manifest_version": 3,
  "name": "PratiBimb S-02a-2a-4 ext-unpinned",
  "version": "1.0.0",
  "description": "Throwaway spike harness. Measures whether connect-src bounds WASM provenance.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:8907/*",
    "http://127.0.0.1:8908/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
