  "oldRule": {
    "rule": "max mAP@0.5 on DEV",
    "chose": 0.05,
    "status": "METHODOLOGICAL DEFECT — superseded, not erased",
    "defect": "mAP@0.5 is a ranking metric and is very nearly invariant to the emit threshold, because lowering the threshold appends predictions to the tail of the ranking where recall is already saturated. Maximising it therefore cannot express a preference between operating points, and the tie-break selected the end of the plateau with the most predictions.",
    "evidence": {
      "mAPRangeAcrossGrid": 0.6186041498735823,
      "mAPRangeWithinPlateau": 0.0004497965114446112,
      "plateauThresholds": [
        0.05,
        0.1,
        0.15,
        0.2
      ],
      "groundingRangeWithinPlateau": 0.1429537801438242,
      "predictionsRangeWithinPlateau": [
        3391,
        11845
      ],
      "verdict": "mAP@0.5 varies by 0.0004 across the plateau while grounding varies by 0.1430. Maximising mAP cannot express a preference between these operating points."
    }
  },
  "candidateRule": {
    "rule": "max F1(element recall, grounding accuracy) on DEV; ties broken to the HIGHER threshold",
