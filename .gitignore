# ─────────────────────────────────────────────────────────────
# PratiBimb — .gitignore
# This is a privacy/security product. Git history is part of the
# threat surface. See SECURITY.md before adding an exception.
# ─────────────────────────────────────────────────────────────

# ── Secrets — never commit ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
service-account*.json
*token*.txt
.hf_token
.huggingface/
# Secret-bearing files, named narrowly on purpose. A broad `*secret*` glob also
# swallows our own tooling (scripts/check-secrets.sh) and legitimate source such as
# packages/security/secret-scan.ts -- an ignore rule that hides real source is worse
# than no rule, because the omission is silent.
secrets.json
secrets.yml
secrets.yaml
*.secret
.secrets/

# ── Real user / PII data — never commit ─────────────────────
# Only synthetic fixtures belong in this repository.
**/real-data/
**/user-data/
**/pii/
**/*.pii.*
captures/
screenshots/real/
**/browsing-history*
**/vault-dump*

# ── Model weights and large binaries — reference, don't vendor ──
*.onnx
*.onnx_data
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.tflite
models/
!models/**/*.md
!models/**/*.json

# ONNX Runtime Web runtime artifacts are 14-28 MB and are referenced by pinned revision,
# never vendored (W1-S03, W1-S02a-2a-3). Small SYNTHETIC .wasm fixtures - the 41-byte
# add.wasm used by W1-S02a-2a-1 and -2a-4 - remain deliberately tracked, which is why this
# is a targeted rule rather than a blanket `*.wasm`.
ort-wasm-*.wasm
ort-wasm-*.mjs
ort.all.min.js

# Generated by build-extension.js at run time; regenerated from node_modules, not committed.
artifacts/experiments/**/served/
artifacts/experiments/**/ext-chrome/
artifacts/experiments/**/ext-firefox/

# ── Browser profiles produced by spikes ─────────────────────
# Chrome user-data-dirs contain profile state; never commit them.
**/chrome-profile/
**/firefox-profile/
**/.wdm/
**/user-data-dir/

# ── Node ────────────────────────────────────────────────────
node_modules/
dist/
build/
.output/
.wxt/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Test / coverage output ──────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# ── OS / editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ── Scratch ─────────────────────────────────────────────────
tmp/
.tmp/
scratch/
*.local

# ADR-0001 gate harness — generated on every run.
# The extensions under build/ are assembled from the production CSP by
# build-gate-extensions.mjs, and results/ is the raw run output. Neither is a source of
# truth: the evidence that is kept lives under artifacts/adr/ADR-0001/.
tests/browser/gates/build/
tests/browser/gates/results/
artifacts/experiments/W1-B02-invariant-e-observation/harness/regression/guard-result.json
