# PratiBimb — environment template
# Copy to .env and fill in locally. .env is gitignored and must NEVER be committed.
# No real secret, token, key or credential belongs in this file.

# ── Server (apps/server) ────────────────────────────────────
# The single origin the extension is permitted to talk to.
# This value is also compiled into the extension manifest CSP connect-src.
PRATIBIMB_SERVER_ORIGIN=http://127.0.0.1:8000

# vLLM / model serving
VLLM_HOST=127.0.0.1
VLLM_PORT=8001
VLLM_MODEL=Qwen/Qwen3-VL-4B-Instruct
VLLM_MAX_MODEL_LEN=8192
# Quantisation is an OPEN QUESTION on 8 GB VRAM - see artifacts/experiments/ENV-0001
VLLM_QUANTIZATION=

# ── Model asset resolution ──────────────────────────────────
# Weights are referenced, never vendored into git. See SECURITY.md.
PRATIBIMB_MODEL_CACHE_DIR=./.model-cache
# If a gated model ever requires a token, it goes in .env only - never here.
HF_TOKEN=

# ── Spike harness ───────────────────────────────────────────
# Local-only collector port used by capability spikes to receive results.
SPIKE_COLLECTOR_PORT=8899
